# SatQuery AI — Environment Configuration
# Copy this file to .env and fill in values
# All keys are OPTIONAL — the app runs with rule-based fallbacks without any of them

# API Key for all /api/* endpoints
SATQUERY_API_KEY=satquery-demo-key-2024

# Google Gemini API Key (free tier — get at https://aistudio.google.com/app/apikey)
# If set, /api/digest/{preset_id} uses Gemini 1.5 Flash instead of rule-based templates
GEMINI_API_KEY=

# Discord Webhook URL for anomaly alerts (optional)
# If set, real HTTP POST is made to this URL when anomaly detector fires
DISCORD_WEBHOOK_URL=

# Comma-separated additional webhook URLs to notify on alerts
SATQUERY_WEBHOOK_URLS=
