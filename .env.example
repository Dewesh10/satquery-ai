# SatQuery AI — Environment Configuration
# Copy this file to .env and fill in your values.
# All keys are OPTIONAL — the app runs with rule-based fallbacks when unset.
# NEVER commit your real .env file. It is listed in .gitignore.

# ── Authentication ─────────────────────────────────────────────────────────────
# API key required for all /api/* endpoints (sent as X-API-Key header)
# Change this to a strong random value before deploying publicly.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SATQUERY_API_KEY=satquery-demo-key-2024

# ── LLM Integration ────────────────────────────────────────────────────────────
# Google Gemini API Key (free tier — https://aistudio.google.com/app/apikey)
# If set, the LLM planner and digest generator use Gemini 2.5 Flash.
# If unset, the app falls back to rule-based regex planning and templates.
GEMINI_API_KEY=

# Which Gemini model to use (defaults to gemini-2.5-flash if unset)
GEMINI_MODEL=gemini-2.5-flash

# ── Webhook Allowlist ──────────────────────────────────────────────────────────
# Discord and Slack domains are always allowed.
# Add custom public domains here as a comma-separated list.
# SSRF protection: private IPs and localhost are always blocked.
ALLOWED_WEBHOOK_DOMAINS=

# Pre-configured Discord webhook URL for anomaly alerts (optional)
DISCORD_WEBHOOK_URL=

# Additional webhook URLs to notify on alerts (comma-separated, Discord/Slack only)
SATQUERY_WEBHOOK_URLS=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Restrict CORS to your deployed frontend URL in production.
# Leave empty to allow all origins (fine for local dev, not for production).
# Example: CORS_ORIGINS=https://satquery.yourdomain.com
CORS_ORIGINS=

# ── Storage ────────────────────────────────────────────────────────────────────
# Absolute path to the SQLite database file.
# On Railway/Fly.io, use a persistent volume mount path (e.g. /app/data/satquery.db).
# On ephemeral hosts, the demo seed data loads on startup automatically.
SATQUERY_DB_PATH=/app/data/satquery_history.db

# ── Deployment notes ───────────────────────────────────────────────────────────
# Rate limiting: 60 requests/minute per IP (built into the middleware)
# This is a DEMO. It is not for operational or safety-critical use.
